      {"when": {"P2017": [3]}, "code": 3},
      {"when": {"P2017": [2], "P2016": [5, 6, 7, 8, 9]}, "code": 3},
      {"when": {"P2017": [2], "P2016": [4], "P2018": [1]}, "code": 3},
      {"when": {"P2017": [2]}, "code": 2},
      {"when": {"P2017": [1], "P2016": [7, 8, 9]}, "code": 2},
      {"when": {"P2017": [1], "P2016": [6], "P2018": [1]}, "code": 2},
